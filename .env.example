# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า key จริง:  cp .env.example .env
# คำเตือน: ห้าม commit ไฟล์ .env เข้า git เด็ดขาด (.env ถูกใส่ไว้ใน .gitignore แล้ว)
# ขอ key ได้จาก https://dashboard.api-football.com (สมัคร API-SPORTS โดยตรง, ต้อง subscribe แพลนก่อน)
# หมายเหตุ: สคริปต์เรียก https://v3.football.api-sports.io โดยตรง — คีย์ของ RapidAPI ใช้กับ endpoint นี้ไม่ได้
API_FOOTBALL_KEY=your_key_here

# คีย์ Claude API สำหรับให้ "เฮียตี๋" วิเคราะห์ (src/analyze.py)
# ขอได้จาก https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# โทเคนบอท Telegram สำหรับ src/bot.py — ขอจาก @BotFather ในแอป Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# กลุ่มที่ต้องเป็นสมาชิกก่อนถึงจะใช้บอทได้ (ไม่ใส่ = ปิดการเช็คสมาชิก ใครก็ใช้ได้)
# หา id กลุ่มได้จากบอทอย่าง @userinfobot หรือ log ของบอทตอนมีคนพิมพ์ในกลุ่ม
GROUP_CHAT_ID=-1001234567890
GROUP_INVITE_LINK=https://t.me/your_group_invite

# Telegram user id ของเจ้าของ ใช้จำกัดสิทธิ์คำสั่ง /postgroup
ADMIN_USER_ID=123456789

# คีย์ OddsPapi สำหรับสคริปต์สำรวจราคาบอล (src/test_oddspapi.py)
# free tier มีแค่ 250 requests/เดือน ใช้อย่างประหยัด
ODDSPAPI_KEY=your_oddspapi_key_here
